# Configuration Firebase (Projet > Paramètres > Général > Vos applications > App Web)
# Ces valeurs sont publiques (elles sont exposées au navigateur), la sécurité réelle
# est assurée par les règles Firestore (firestore.rules).
# Pas de Firebase Storage utilisé (payant depuis 02/2026) : les photos passent par Cloudinary.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Configuration Cloudinary (gratuit, sans carte bancaire) pour l'hébergement des photos produits.
# Cloudinary > Dashboard > "Cloud name", puis Settings > Upload > Add upload preset (Signing Mode: Unsigned)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
