rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Produits : lecture publique des produits publiés, brouillons visibles par l'admin uniquement.
    match /products/{productId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }

    // Catégories : lecture publique, écriture admin.
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Réglages du site (thème, contenu, SEO...) : lecture publique, écriture admin.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Commandes : création publique (checkout), lecture unitaire publique (confirmation, via l'ID
    // aléatoire de la commande), liste et modification réservées à l'admin.
    match /orders/{orderId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Administrateurs : un utilisateur peut lire son propre statut ; un admin peut lire la liste
    // complète et ajouter/retirer d'autres admins (mais seulement un compte déjà admin, jamais
    // un compte quelconque — évite qu'un utilisateur s'auto-attribue les droits admin).
    match /admins/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // Bibliothèque média : photos déjà envoyées sur Cloudinary, réutilisables entre produits.
    // Usage interne à l'admin uniquement.
    match /media/{mediaId} {
      allow read, write: if isAdmin();
    }

    // Contenu d'enrichissement des produits Shopify (photos, FAQ, SEO...) : lecture publique
    // (utilisée sur la fiche produit du site), écriture admin uniquement.
    match /shopifyProductContent/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Articles de blog : lecture publique des articles publiés, brouillons visibles par l'admin uniquement.
    match /posts/{postId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }
  }
}
